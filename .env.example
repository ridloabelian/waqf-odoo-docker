# ==============================================================================
# WAQF ODOO DOCKER - ENVIRONMENT CONFIGURATION
# Inisiatif Bersama: Amal Produktif, FWP & Asosiasi Nazhir Indonesia (ANI)
# Standar Akuntansi PSAK 412 (PSAK 112) & Standar LSP BWI
# ==============================================================================
# Salin file ini menjadi '.env' dan sesuaikan nilainya:
#   cp .env.example .env
# Atau jalankan:
#   ./init-setup.sh (akan men-generate password acak secara otomatis)
# ==============================================================================

# ------------------------------------------------------------------------------
# 0. DOCKER IMAGES (ODOO 19, 18 LTS & 17)
# ------------------------------------------------------------------------------
# Versi Odoo yang digunakan:
# - odoo:19.0 (Default versi rilis terbaru)
# - odoo:18.0 (Versi LTS produksi sangat stabil)
# - odoo:17.0 (Versi sebelumnya)
ODOO_IMAGE=odoo:19.0

# Versi PostgreSQL (default: postgres:17-alpine, alternatif: postgres:16-alpine)
POSTGRES_IMAGE=postgres:17-alpine

# ------------------------------------------------------------------------------
# 1. DOMAIN & REVERSE PROXY (SSL LET'S ENCRYPT)
# ------------------------------------------------------------------------------
# Masukkan nama domain publik Anda yang sudah diarahkan (DNS A record) ke IP VPS.
# Contoh: erp.nazhirwakaf.id atau demo.fwp.or.id
# Untuk pengujian lokal di VPS tanpa domain publik, gunakan: localhost atau IP VPS
DOMAIN_NAME=localhost

# Email untuk pendaftaran sertifikat SSL otomatis Let's Encrypt
ACME_EMAIL=admin@fwp.or.id

# Port HTTP & HTTPS di host (biasanya 80 & 443 untuk server produksi bersih)
HTTP_PORT=80
HTTPS_PORT=443

# ------------------------------------------------------------------------------
# 2. POSTGRESQL DATABASE CREDENTIALS
# ------------------------------------------------------------------------------
# Nama database default postgres internal (biasanya tetap postgres)
POSTGRES_DB=postgres

# Username pengguna database untuk Odoo
POSTGRES_USER=odoo

# Password database yang kuat (Wajib diganti, akan digenerate otomatis oleh init-setup.sh)
POSTGRES_PASSWORD=GantiDenganPasswordDatabaseYangSangatKuatDanAman123!

# ------------------------------------------------------------------------------
# 3. ODOO MASTER ADMIN PASSWORD
# ------------------------------------------------------------------------------
# Master password untuk membuat, menduplikasi, membackup, dan menghapus database
# melalui antarmuka web /web/database/manager
# (Wajib diganti, akan digenerate otomatis oleh init-setup.sh)
ADMIN_PASSWORD=GantiDenganMasterPasswordOdooYangSangatKuatDanAman123!

# ------------------------------------------------------------------------------
# 4. TUNING RESOURCE & WORKER ODOO (OPTIMASI VPS 4 GB - 8 GB RAM)
# ------------------------------------------------------------------------------
# Rumus worker ideal: (Jumlah CPU Core * 2) + 1
# Contoh:
# VPS 2 Core CPU -> 4 s/d 5 worker
# VPS 4 Core CPU -> 8 s/d 9 worker
ODOO_WORKERS=4

# Alokasi batas memori per worker (dalam bytes)
# 2147483648 = 2048 MB (2 GB) Soft limit
# 2684354560 = 2560 MB (2.5 GB) Hard limit
ODOO_LIMIT_MEMORY_SOFT=2147483648
ODOO_LIMIT_MEMORY_HARD=2684354560

# Batas waktu eksekusi CPU & Real time untuk laporan akuntansi/PSAK 112 yang kompleks (detik)
ODOO_LIMIT_TIME_CPU=600
ODOO_LIMIT_TIME_REAL=1200

# ------------------------------------------------------------------------------
# 5. BACKUP & CLOUD STORAGE (RCLONE OFFSITE)
# ------------------------------------------------------------------------------
# Lokasi penyimpanan backup lokal
BACKUP_DIR=./backups

# Retensi backup lokal (hari). Backup lebih tua dari angka ini akan dihapus otomatis.
BACKUP_RETENTION_DAYS=7

# Integrasi Rclone untuk upload offsite ke cloud (Google Drive, AWS S3, Cloudflare R2, MinIO)
# Kosongkan jika belum menggunakan rclone offsite.
# Contoh: RCLONE_REMOTE=gdrive_fwp
RCLONE_REMOTE=
# Path folder di remote cloud storage
RCLONE_DEST_PATH=WaqfOdooBackups
