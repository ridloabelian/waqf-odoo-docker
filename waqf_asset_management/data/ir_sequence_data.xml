<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="seq_waqf_asset" model="ir.sequence">
        <field name="name">Nomor Registrasi Aset Fisik Wakaf</field>
        <field name="code">waqf.asset</field>
        <field name="prefix">AST/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="seq_waqf_asset_inspection" model="ir.sequence">
        <field name="name">Nomor Log Inspeksi Aset Wakaf</field>
        <field name="code">waqf.asset.inspection</field>
        <field name="prefix">INSP/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>
