<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">
    <t t-name="l10n_id_waqf_psak112.Psak112Dashboard">
        <div class="o_action o_view_controller bg-view d-flex flex-column h-100 overflow-auto p-4">
            <!-- Header & Filter Bar -->
            <div class="d-flex flex-wrap justify-content-between align-items-center pb-3 border-bottom mb-4">
                <div>
                    <h3 class="fw-bold mb-1 text-success d-flex align-items-center">
                        <i class="fa fa-balance-scale me-2"/>
                        Dashboard &amp; Pelaporan Akuntansi Wakaf (PSAK 112)
                    </h3>
                    <div class="text-muted small">
                        Standar IAI &amp; Regulasi UU No. 41 Tahun 2004 | Entitas: <strong class="text-dark"><t t-esc="state.companyName"/></strong>
                    </div>
                </div>

                <!-- Date Filter & Actions -->
                <div class="d-flex flex-wrap align-items-center gap-2 mt-2 mt-md-0">
                    <div class="input-group input-group-sm">
                        <span class="input-group-text bg-light">Dari</span>
                        <input type="date" class="form-control form-control-sm" t-model="state.dateFrom" t-on-change="onDateFromChange"/>
                    </div>
                    <div class="input-group input-group-sm">
                        <span class="input-group-text bg-light">Sampai</span>
                        <input type="date" class="form-control form-control-sm" t-model="state.dateTo" t-on-change="onDateToChange"/>
                    </div>
                    <button class="btn btn-sm btn-outline-secondary" t-on-click="loadData" title="Segarkan Data">
                        <i class="fa fa-refresh me-1"/> Segarkan
                    </button>
                    <button class="btn btn-sm btn-success fw-bold" t-on-click="openPdfWizard">
                        <i class="fa fa-file-pdf-o me-1"/> Cetak PDF Resmi
                    </button>
                </div>
            </div>

            <!-- KPI Cards Ribbon -->
            <div class="row g-3 mb-4">
                <!-- Total Aset Wakaf -->
                <div class="col-12 col-sm-6 col-xl">
                    <div class="card shadow-sm border-0 bg-light-subtle h-100">
                        <div class="card-body p-3">
                            <div class="text-muted small fw-semibold text-uppercase">Total Aset Wakaf</div>
                            <h4 class="fw-bold text-dark my-1"><t t-esc="state.kpis.total_aset_fmt or 'Rp 0'"/></h4>
                            <div class="small text-success"><i class="fa fa-shield me-1"/> Terinventarisasi Resmi</div>
                        </div>
                    </div>
                </div>

                <!-- Aset Neto Permanen -->
                <div class="col-12 col-sm-6 col-xl">
                    <div class="card shadow-sm border-0 border-start border-4 border-success h-100">
                        <div class="card-body p-3">
                            <div class="text-muted small fw-semibold text-uppercase">Neto Terikat Permanen</div>
                            <h4 class="fw-bold text-success my-1"><t t-esc="state.kpis.net_perm_fmt or 'Rp 0'"/></h4>
                            <div class="small text-danger"><i class="fa fa-lock me-1"/> Pokok Abadi (Haram Berkurang)</div>
                        </div>
                    </div>
                </div>

                <!-- Aset Neto Temporer -->
                <div class="col-12 col-sm-6 col-xl">
                    <div class="card shadow-sm border-0 border-start border-4 border-warning h-100">
                        <div class="card-body p-3">
                            <div class="text-muted small fw-semibold text-uppercase">Neto Terikat Temporer</div>
                            <h4 class="fw-bold text-warning my-1"><t t-esc="state.kpis.net_temp_fmt or 'Rp 0'"/></h4>
                            <div class="small text-muted"><i class="fa fa-clock-o me-1"/> Wakaf Berjangka Waktu</div>
                        </div>
                    </div>
                </div>

                <!-- Aset Neto Tidak Terikat (Surplus Siap Salur) -->
                <div class="col-12 col-sm-6 col-xl">
                    <div class="card shadow-sm border-0 border-start border-4 border-info h-100">
                        <div class="card-body p-3">
                            <div class="text-muted small fw-semibold text-uppercase">Neto Tidak Terikat</div>
                            <h4 class="fw-bold text-info my-1"><t t-esc="state.kpis.net_unrest_fmt or 'Rp 0'"/></h4>
                            <div class="small text-success"><i class="fa fa-heart me-1"/> Surplus Siap Salur Mauquf 'Alaih</div>
                        </div>
                    </div>
                </div>

                <!-- Rasio Hak Nazhir -->
                <div class="col-12 col-sm-6 col-xl">
                    <div class="card shadow-sm border-0 border-start border-4 border-primary h-100">
                        <div class="card-body p-3">
                            <div class="text-muted small fw-semibold text-uppercase">Rasio Hak Nazhir</div>
                            <h4 class="fw-bold my-1" t-att-class="state.kpis.nazhir_valid ? 'text-primary' : 'text-danger'">
                                <t t-esc="state.kpis.nazhir_pct or 0"/>%
                            </h4>
                            <div class="small" t-if="state.kpis.nazhir_valid">
                                <span class="badge text-bg-success">Patuh UU 41/2004 (≤ 10%)</span>
                            </div>
                            <div class="small" t-else="">
                                <span class="badge text-bg-danger">Melebihi Maks 10%!</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Navigation Tabs for 4 Reports -->
            <ul class="nav nav-pills mb-3 border-bottom pb-2">
                <li class="nav-item">
                    <button class="nav-link"
                            t-att-class="{'active': state.reportType === 'financial_position'}"
                            t-on-click="() => this.onSelectReportType('financial_position')">
                        <i class="fa fa-university me-1"/> 1. Laporan Posisi Keuangan
                    </button>
                </li>
                <li class="nav-item">
                    <button class="nav-link"
                            t-att-class="{'active': state.reportType === 'asset_detail'}"
                            t-on-click="() => this.onSelectReportType('asset_detail')">
                        <i class="fa fa-cubes me-1"/> 2. Laporan Rincian Aset Wakaf
                    </button>
                </li>
                <li class="nav-item">
                    <button class="nav-link"
                            t-att-class="{'active': state.reportType === 'activity'}"
                            t-on-click="() => this.onSelectReportType('activity')">
                        <i class="fa fa-line-chart me-1"/> 3. Laporan Aktivitas
                    </button>
                </li>
                <li class="nav-item">
                    <button class="nav-link"
                            t-att-class="{'active': state.reportType === 'cash_flow'}"
                            t-on-click="() => this.onSelectReportType('cash_flow')">
                        <i class="fa fa-money me-1"/> 4. Laporan Arus Kas
                    </button>
                </li>
            </ul>

            <!-- Content Area: Report Tables -->
            <div class="card shadow-sm border-0 flex-grow-1">
                <div class="card-body p-0">
                    <div t-if="state.loading" class="text-center py-5">
                        <i class="fa fa-circle-o-notch fa-spin fa-2x text-success"/>
                        <p class="mt-2 text-muted">Memuat data akuntansi wakaf...</p>
                    </div>

                    <div t-else="" class="table-responsive p-3">
                        <!-- TAB 1: POSISI KEUANGAN -->
                        <table t-if="state.reportType === 'financial_position'" class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th style="width: 70%;">Komponen Akun PSAK 112</th>
                                    <th class="text-end" style="width: 30%;">Saldo (IDR)</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr class="table-light fw-bold text-success"><td colspan="2">ASET WAKAF</td></tr>
                                <tr>
                                    <td class="ps-4">Kas &amp; Setara Kas Wakaf (LKS-PWU)</td>
                                    <td class="text-end fw-semibold"><t t-esc="state.reportData.kas_wakaf ? state.reportData.kas_wakaf.fmt : 'Rp 0'"/></td>
                                </tr>
                                <tr>
                                    <td class="ps-4">Piutang Bagi Hasil &amp; Pengelolaan</td>
                                    <td class="text-end fw-semibold"><t t-esc="state.reportData.piutang ? state.reportData.piutang.fmt : 'Rp 0'"/></td>
                                </tr>
                                <tr>
                                    <td class="ps-4">Investasi Portofolio Produktif (Sukuk/CWLS/Saham Syariah)</td>
                                    <td class="text-end fw-semibold"><t t-esc="state.reportData.investasi ? state.reportData.investasi.fmt : 'Rp 0'"/></td>
                                </tr>
                                <tr>
                                    <td class="ps-4">Aset Tetap Wakaf - Tanah</td>
                                    <td class="text-end fw-semibold"><t t-esc="state.reportData.tanah ? state.reportData.tanah.fmt : 'Rp 0'"/></td>
                                </tr>
                                <tr>
                                    <td class="ps-4">Aset Tetap Wakaf - Bangunan &amp; Sarana Fisik</td>
                                    <td class="text-end fw-semibold"><t t-esc="state.reportData.bangunan ? state.reportData.bangunan.fmt : 'Rp 0'"/></td>
                                </tr>
                                <tr>
                                    <td class="ps-4">Akumulasi Penyusutan Bangunan</td>
                                    <td class="text-end text-muted">(<t t-esc="state.reportData.penyusutan ? state.reportData.penyusutan.fmt : 'Rp 0'"/>)</td>
                                </tr>
                                <tr class="table-success fw-bold">
                                    <td>TOTAL ASET WAKAF</td>
                                    <td class="text-end"><t t-esc="state.reportData.total_aset ? state.reportData.total_aset.fmt : 'Rp 0'"/></td>
                                </tr>

                                <tr class="table-light fw-bold text-secondary"><td colspan="2">LIABILITAS</td></tr>
                                <tr>
                                    <td class="ps-4">Liabilitas Jangka Pendek Pengelolaan</td>
                                    <td class="text-end fw-semibold"><t t-esc="state.reportData.liab_pendek ? state.reportData.liab_pendek.fmt : 'Rp 0'"/></td>
                                </tr>
                                <tr>
                                    <td class="ps-4">Liabilitas Pengembalian Pokok Wakaf Berjangka</td>
                                    <td class="text-end fw-semibold"><t t-esc="state.reportData.liab_temporer ? state.reportData.liab_temporer.fmt : 'Rp 0'"/></td>
                                </tr>
                                <tr class="fw-bold">
                                    <td>TOTAL LIABILITAS</td>
                                    <td class="text-end"><t t-esc="state.reportData.total_liabilitas ? state.reportData.total_liabilitas.fmt : 'Rp 0'"/></td>
                                </tr>

                                <tr class="table-light fw-bold text-primary"><td colspan="2">ASET NETO (PSAK 112)</td></tr>
                                <tr>
                                    <td class="ps-4">Aset Neto Terikat Permanen (Pokok Wakaf Abadi)</td>
                                    <td class="text-end fw-bold text-success"><t t-esc="state.reportData.neto_permanen ? state.reportData.neto_permanen.fmt : 'Rp 0'"/></td>
                                </tr>
                                <tr>
                                    <td class="ps-4">Aset Neto Terikat Temporer (Pokok Wakaf Berjangka)</td>
                                    <td class="text-end fw-semibold text-warning"><t t-esc="state.reportData.neto_temporer ? state.reportData.neto_temporer.fmt : 'Rp 0'"/></td>
                                </tr>
                                <tr>
                                    <td class="ps-4">Aset Neto Tidak Terikat (Surplus Pengelolaan Belum Disalurkan)</td>
                                    <td class="text-end fw-semibold text-info"><t t-esc="state.reportData.neto_tidak_terikat ? state.reportData.neto_tidak_terikat.fmt : 'Rp 0'"/></td>
                                </tr>
                                <tr class="table-info fw-bold">
                                    <td>TOTAL ASET NETO</td>
                                    <td class="text-end"><t t-esc="state.reportData.total_aset_neto ? state.reportData.total_aset_neto.fmt : 'Rp 0'"/></td>
                                </tr>
                                <tr class="table-dark fw-bold fs-6">
                                    <td>TOTAL LIABILITAS DAN ASET NETO</td>
                                    <td class="text-end"><t t-esc="state.reportData.total_liab_neto ? state.reportData.total_liab_neto.fmt : 'Rp 0'"/></td>
                                </tr>
                            </tbody>
                        </table>

                        <!-- TAB 2: RINCIAN ASET WAKAF -->
                        <table t-if="state.reportType === 'asset_detail'" class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th style="width: 50%;">Kategori &amp; Spesifikasi Harta Benda Wakaf</th>
                                    <th style="width: 25%;">Klasifikasi Sifat Wakaf</th>
                                    <th class="text-end" style="width: 25%;">Nilai / Taksiran (IDR)</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr class="table-light fw-bold text-success"><td colspan="3">A. WAKAF UANG (CASH WAQF)</td></tr>
                                <tr>
                                    <td class="ps-4">Wakaf Uang Abadi / Muabbad</td>
                                    <td><span class="badge text-bg-success">Permanen</span></td>
                                    <td class="text-end fw-semibold"><t t-esc="state.reportData.cash_permanent ? state.reportData.cash_permanent.fmt : 'Rp 0'"/></td>
                                </tr>
                                <tr>
                                    <td class="ps-4">Wakaf Uang Berjangka / Muaqqat</td>
                                    <td><span class="badge text-bg-warning">Temporer</span></td>
                                    <td class="text-end fw-semibold"><t t-esc="state.reportData.cash_temporary ? state.reportData.cash_temporary.fmt : 'Rp 0'"/></td>
                                </tr>

                                <tr class="table-light fw-bold text-primary"><td colspan="3">B. BENDA TIDAK BERGERAK</td></tr>
                                <tr>
                                    <td class="ps-4">Tanah Wakaf Bersertifikat</td>
                                    <td><span class="badge text-bg-success">Permanen</span></td>
                                    <td class="text-end fw-semibold"><t t-esc="state.reportData.immovable_land ? state.reportData.immovable_land.fmt : 'Rp 0'"/></td>
                                </tr>
                                <tr>
                                    <td class="ps-4">Bangunan, Pesantren, Ruko &amp; Sarana Fisik</td>
                                    <td><span class="badge text-bg-success">Permanen</span></td>
                                    <td class="text-end fw-semibold"><t t-esc="state.reportData.immovable_building ? state.reportData.immovable_building.fmt : 'Rp 0'"/></td>
                                </tr>

                                <tr class="table-light fw-bold text-secondary"><td colspan="3">C. BENDA BERGERAK SELAIN UANG</td></tr>
                                <tr>
                                    <td class="ps-4">Kendaraan Operasional, Mesin, HAKI &amp; Logam Mulia</td>
                                    <td><span class="badge text-bg-info">Permanen / Temporer</span></td>
                                    <td class="text-end fw-semibold"><t t-esc="state.reportData.movable_other ? state.reportData.movable_other.fmt : 'Rp 0'"/></td>
                                </tr>
                            </tbody>
                        </table>

                        <!-- TAB 3: LAPORAN AKTIVITAS -->
                        <table t-if="state.reportType === 'activity'" class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th style="width: 70%;">Uraian Penerimaan &amp; Penyaluran</th>
                                    <th class="text-end" style="width: 30%;">Jumlah (IDR)</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr class="table-light fw-bold text-success"><td colspan="2">PENERIMAAN WAKAF &amp; HASIL PENGELOLAAN</td></tr>
                                <tr>
                                    <td class="ps-4">Penerimaan Wakaf Uang Permanen</td>
                                    <td class="text-end fw-semibold"><t t-esc="state.reportData.terima_permanen ? state.reportData.terima_permanen.fmt : 'Rp 0'"/></td>
                                </tr>
                                <tr>
                                    <td class="ps-4">Penerimaan Wakaf Uang Temporer</td>
                                    <td class="text-end fw-semibold"><t t-esc="state.reportData.terima_temporer ? state.reportData.terima_temporer.fmt : 'Rp 0'"/></td>
                                </tr>
                                <tr>
                                    <td class="ps-4">Penerimaan Wakaf Aset Selain Uang</td>
                                    <td class="text-end fw-semibold"><t t-esc="state.reportData.terima_nonkas ? state.reportData.terima_nonkas.fmt : 'Rp 0'"/></td>
                                </tr>
                                <tr>
                                    <td class="ps-4">Hasil Pengelolaan &amp; Pengembangan Wakaf Produktif</td>
                                    <td class="text-end fw-semibold"><t t-esc="state.reportData.hasil_kelola ? state.reportData.hasil_kelola.fmt : 'Rp 0'"/></td>
                                </tr>
                                <tr class="table-success fw-bold">
                                    <td>TOTAL PENERIMAAN</td>
                                    <td class="text-end"><t t-esc="state.reportData.total_penerimaan ? state.reportData.total_penerimaan.fmt : 'Rp 0'"/></td>
                                </tr>

                                <tr class="table-light fw-bold text-danger"><td colspan="2">PENGELUARAN &amp; PENYALURAN</td></tr>
                                <tr>
                                    <td class="ps-4">Bagian Hak Imbalan Nazhir (Maks 10% UU 41/2004)</td>
                                    <td class="text-end fw-semibold"><t t-esc="state.reportData.hak_nazhir ? state.reportData.hak_nazhir.fmt : 'Rp 0'"/></td>
                                </tr>
                                <tr>
                                    <td class="ps-4">Beban Operasional Pengelolaan &amp; Pemeliharaan Aset</td>
                                    <td class="text-end fw-semibold"><t t-esc="state.reportData.beban_kelola ? state.reportData.beban_kelola.fmt : 'Rp 0'"/></td>
                                </tr>
                                <tr>
                                    <td class="ps-4">Penyaluran Manfaat Wakaf kepada Mauquf 'Alaih</td>
                                    <td class="text-end fw-semibold"><t t-esc="state.reportData.beban_salur ? state.reportData.beban_salur.fmt : 'Rp 0'"/></td>
                                </tr>
                                <tr class="table-danger fw-bold">
                                    <td>TOTAL PENGELUARAN &amp; PENYALURAN</td>
                                    <td class="text-end"><t t-esc="state.reportData.total_beban ? state.reportData.total_beban.fmt : 'Rp 0'"/></td>
                                </tr>

                                <tr class="table-dark fw-bold fs-6">
                                    <td>SURPLUS / (DEFISIT) PERIODE BERJALAN</td>
                                    <td class="text-end"><t t-esc="state.reportData.surplus_periode ? state.reportData.surplus_periode.fmt : 'Rp 0'"/></td>
                                </tr>
                            </tbody>
                        </table>

                        <!-- TAB 4: LAPORAN ARUS KAS -->
                        <table t-if="state.reportType === 'cash_flow'" class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th style="width: 70%;">Aktivitas Arus Kas Wakaf</th>
                                    <th class="text-end" style="width: 30%;">Jumlah (IDR)</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr class="table-light fw-bold text-success"><td colspan="2">ARUS KAS DARI AKTIVITAS OPERASI &amp; PENYALURAN</td></tr>
                                <tr>
                                    <td class="ps-4">Kas Diterima dari Hasil Pengelolaan Wakaf Produktif</td>
                                    <td class="text-end fw-semibold"><t t-esc="state.reportData.kas_hasil_kelola ? state.reportData.kas_hasil_kelola.fmt : 'Rp 0'"/></td>
                                </tr>
                                <tr>
                                    <td class="ps-4">Kas Disalurkan untuk Manfaat Mauquf 'Alaih</td>
                                    <td class="text-end text-danger">(<t t-esc="state.reportData.kas_salur ? state.reportData.kas_salur.fmt : 'Rp 0'"/>)</td>
                                </tr>
                                <tr>
                                    <td class="ps-4">Kas Dibayarkan untuk Hak Nazhir &amp; Operasional</td>
                                    <td class="text-end text-danger">(<t t-esc="state.reportData.kas_hak_nazhir ? state.reportData.kas_hak_nazhir.fmt : 'Rp 0'"/>)</td>
                                </tr>
                                <tr class="fw-bold">
                                    <td>Arus Kas Bersih dari Aktivitas Operasi</td>
                                    <td class="text-end"><t t-esc="state.reportData.arus_kas_operasi ? state.reportData.arus_kas_operasi.fmt : 'Rp 0'"/></td>
                                </tr>

                                <tr class="table-light fw-bold text-primary"><td colspan="2">ARUS KAS DARI PENERIMAAN POKOK WAKAF</td></tr>
                                <tr>
                                    <td class="ps-4">Penerimaan Kas Pokok Wakaf Permanen</td>
                                    <td class="text-end fw-semibold"><t t-esc="state.reportData.kas_terima_permanen ? state.reportData.kas_terima_permanen.fmt : 'Rp 0'"/></td>
                                </tr>
                                <tr>
                                    <td class="ps-4">Penerimaan Kas Pokok Wakaf Temporer</td>
                                    <td class="text-end fw-semibold"><t t-esc="state.reportData.kas_terima_temporer ? state.reportData.kas_terima_temporer.fmt : 'Rp 0'"/></td>
                                </tr>
                                <tr class="fw-bold">
                                    <td>Arus Kas Bersih dari Penerimaan Pokok Wakaf</td>
                                    <td class="text-end"><t t-esc="state.reportData.arus_kas_wakaf ? state.reportData.arus_kas_wakaf.fmt : 'Rp 0'"/></td>
                                </tr>

                                <tr class="table-success fw-bold">
                                    <td>KENAIKAN (PENURUNAN) BERSIH KAS WAKAF</td>
                                    <td class="text-end"><t t-esc="state.reportData.kenaikan_bersih_kas ? state.reportData.kenaikan_bersih_kas.fmt : 'Rp 0'"/></td>
                                </tr>
                                <tr>
                                    <td>Saldo Awal Kas dan Setara Kas</td>
                                    <td class="text-end"><t t-esc="state.reportData.saldo_awal_kas ? state.reportData.saldo_awal_kas.fmt : 'Rp 0'"/></td>
                                </tr>
                                <tr class="table-dark fw-bold fs-6">
                                    <td>SALDO AKHIR KAS DAN SETARA KAS</td>
                                    <td class="text-end"><t t-esc="state.reportData.saldo_akhir_kas ? state.reportData.saldo_akhir_kas.fmt : 'Rp 0'"/></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </t>
</templates>
