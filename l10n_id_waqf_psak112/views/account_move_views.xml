<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_waqf_psak112" model="ir.ui.view">
        <field name="name">account.move.form.waqf.psak112</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <field name="ref" position="after">
                <field name="waqf_pledge_id" options="{'no_create': True}" placeholder="Pilih AIW / APAIW terkait..."/>
            </field>
            <!-- Add column in line_ids -->
            <xpath expr="//field[@name='line_ids']/tree/field[@name='account_id']" position="after">
                <field name="waqf_net_asset_type" optional="show" widget="badge"
                       decoration-primary="waqf_net_asset_type == 'permanent'"
                       decoration-warning="waqf_net_asset_type == 'temporary'"
                       decoration-success="waqf_net_asset_type == 'unrestricted'"/>
            </xpath>
        </field>
    </record>

    <record id="view_account_move_filter_waqf" model="ir.ui.view">
        <field name="name">account.move.select.waqf</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_account_move_filter"/>
        <field name="arch" type="xml">
            <filter name="posted" position="after">
                <filter string="Transaksi Wakaf" name="filter_waqf_transaction" domain="[('is_waqf_transaction', '=', True)]"/>
            </filter>
        </field>
    </record>
</odoo>
